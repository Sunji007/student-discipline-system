nded=0;endArrow=block;endFill=1;endSize=10;startArrow=none;strokeColor=#334155;fontSize=20;labelBackgroundColor=#ffffff;labelBorderColor=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="P6" target="P2"><mxGeometry relative="1" as="geometry"><mxPoint x="145" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="F44" value="แจ้งผู้ถูกกล่าวหา" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;endSize=10;startArrow=none;strokeColor=#334155;fontSize=20;labelBackgroundColor=#ffffff;labelBorderColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="P6" target="P7"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="title" value="&lt;b&gt;DFD Level 0 — ระบบบริหารพฤติกรรมนักเรียน&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=44;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="36" width="4400" height="70" as="geometry"/></mxCell><mxCell id="subtitle" value="8 โปรเซส · คลังข้อมูล 8 แห่ง (D1–D8) · ผู้เกี่ยวข้อง 5 กลุ่ม · อ้างอิงข้อมูลจากไฟล์ Teacher Behavior Scoring" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="4400" height="50" as="geometry"/></mxCell><mxCell id="legend_title" value="&lt;b&gt;คำอธิบายสัญลักษณ์&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=30;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="2540" width="1240" height="70" as="geometry"/></mxCell><mxCell id="legend_text" value="กรอบมุมมน  =  โปรเซส (1.0–8.0)&lt;br&gt;สี่เหลี่ยม  =  ผู้เกี่ยวข้องภายนอกระบบ&lt;br&gt;กรอบเปิดด้านขวา  =  คลังข้อมูล D1–D8&lt;br&gt;ลูกศร  =  ทิศทางการไหลของข้อมูล&lt;br&gt;&lt;br&gt;&lt;b&gt;รหัสที่ซ้ำกันหมายถึงผู้เกี่ยวข้องหรือคลังข้อมูลเดียวกัน&lt;/b&gt;&lt;br&gt;แสดงซ้ำเพื่อหลีกเลี่ยงเส้นตัดกัน ไม่ใช่คลังข้อมูลเพิ่มเติม&lt;br&gt;&lt;br&gt;เส้นรับ–ส่งสองทิศทางเดิม 6 รายการ แยกเป็นขาเข้า/ขาออก" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=25;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="2620" width="1240" height="450" as="geometry"/></mxCell><mxCell id="footer" value="แหล่งข้อมูล: Teacher Behavior Scoring _ Mermaid.html | 38 ความสัมพันธ์เดิม → 44 ลูกศรแสดงทิศทางข้อมูล" style="html=1;whiteSpace=wrap;fontFamily=Tahoma;fontColor=#1f2937;strokeWidth=2;text;strokeColor=none;fillColor=none;fontSize=23;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="3370" width="4400" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
